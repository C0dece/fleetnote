{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleetnote",
  "version": "0.3.2",
  "identifier": "app.fleetnote.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fleetnote",
        "width": 1180,
        "height": 780,
        "minWidth": 380,
        "minHeight": 480,
        "decorations": true,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown-база знаний с синхронизацией через любое облако",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
